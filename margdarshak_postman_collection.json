              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"twitter\",\n  \"message\": \"Traffic alert: Accident on GH Road Gandhinagar. Diversions active.\",\n  \"incident_id\": \"INC_001\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/publish",
              "protocol": "http",
