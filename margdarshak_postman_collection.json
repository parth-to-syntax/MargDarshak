    },
    {
      "name": "System Debug & Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/health",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["health"]
            },
            "description": "Basic server health indicator."
          }
        },
        {
          "name": "Get Incident Debug Log",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/debug/log?incident_id=INC_001",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["debug", "log"],
              "query": [
                {
                  "key": "incident_id",
                  "value": "INC_001"
                }
              ]
            },
            "description": "Retrieves backend processing logs (A* path nodes explored, weights, execution times) for a given incident."
          }
        },
        {
          "name": "Verify Path & Pipeline (Verify)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/debug/verify/INC_001?include_routes=true",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["debug", "verify", "INC_001"],
              "query": [
                {
                  "key": "include_routes",
                  "value": "true"
                }
              ]
            },
            "description": "Advanced debug validation report on routing state, blocked coordinates, and AI narrative previews."
          }
        },
        {
          "name": "Incident Logs (System Audit Log)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/incident/logs",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["incident", "logs"]
            },
            "description": "Returns audit logs of all active operations and state changes."
          }
        }
      ]
    }
  ]
