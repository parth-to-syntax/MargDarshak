              "path": ["publish"]
            },
            "description": "Publishes traffic notification alerts to Twitter (X)."
          }
        },
        {
          "name": "Get Publish Logs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/publish_log",
              "protocol": "http",
              "host": ["localhost"],
