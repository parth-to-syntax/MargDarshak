    },
    {
      "name": "Routing & Co-Pilot Insights",
      "item": [
        {
          "name": "Get Diversion Detours",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/diversion/INC_001",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["diversion", "INC_001"]
            },
            "description": "Generates top 3 BPR load-aware detour paths and coordinate polylines avoiding blocked nodes."
          }
        },
        {
          "name": "Get AI Insights",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/insights/INC_001",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["insights", "INC_001"]
            },
            "description": "Returns AI-analyzed traffic brief narrative, retiming parameters, and diversion summary."
          }
        },
        {
          "name": "Q&A Copilot Chat",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Is there any congestion on CH Road?\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/chat",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["chat"]
            },
            "description": "Multi-turn officer Q&A conversational interface with LLM."
          }
        },
        {
          "name": "Get Narrative Log",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/narrativelog",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["narrativelog"]
            },
            "description": "Retrieves the history logs of LLM narrative decisions."
          }
        }
      ]
    },
    {
