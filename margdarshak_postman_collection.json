{
  "info": {
    "_postman_id": "08938002-7b42-407b-86c5-c78b3b8c0715",
    "name": "MargDarshak API Collection",
    "description": "Complete collection of MargDarshak (formerly SkyGrid) backend endpoints. Designed to inspect, test, and manage Ghent/Gandhinagar traffic incidents, detour routing, and AI co-pilot insights.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication & Session",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["login"]
            },
            "description": "Logs in the user and issues a secure HTTP-Only cookie `margdarshak_session`."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/logout",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["logout"]
            },
            "description": "Logs out the user and clears the active session cookie."
          }
        },
        {
          "name": "Get Profile (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/me",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["me"]
            },
            "description": "Returns current logged in user details."
          }
        }
      ]
    },
    {
      "name": "User Management (Admin-Only)",
      "item": [
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/admin/users?page=1&search=",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["admin", "users"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "search",
                  "value": ""
                }
              ]
            },
            "description": "Lists all system users. Requires admin session."
          }
        },
        {
          "name": "Create User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"officer_test\",\n  \"email\": \"officer@margdarshak.city\",\n  \"role\": \"officer\",\n  \"send_email\": false\n}"
            },
            "url": {
              "raw": "http://localhost:8000/admin/users",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["admin", "users"]
            },
            "description": "Creates a new user. Auto-generates password. Requires admin session."
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/admin/users/2",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["admin", "users", "2"]
            },
            "description": "Deletes a user by ID. Requires admin session."
          }
        }
      ]
    },
    {
      "name": "Incident Reporting & Lifecycle",
      "item": [
        {
          "name": "Trigger Manual Incident",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seg_id\": \"seg_001\",\n  \"street_name\": \"GH Road\",\n  \"incident_type\": \"ACCIDENT\",\n  \"lat\": 23.2211,\n  \"lng\": 72.6439,\n  \"seg_start_lat\": 23.2215,\n  \"seg_start_lng\": 72.6442,\n  \"seg_end_lat\": 23.2206,\n  \"seg_end_lng\": 72.6437\n}"
            },
            "url": {
              "raw": "http://localhost:8000/incident/trigger",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["incident", "trigger"]
            },
            "description": "Manually triggers a new traffic incident. Launches background detour routing and AI insights analysis threads."
          }
        },
        {
          "name": "Acknowledge Incident",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/incident/acknowledge/INC_001",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["incident", "acknowledge", "INC_001"]
            },
            "description": "Acknowledges an active incident, setting `acknowledged_at` timestamp."
          }
        },
        {
          "name": "Resolve Incident",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8000/incident/resolve/INC_001",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["incident", "resolve", "INC_001"]
            },
            "description": "Resolves an active incident. Restores road capacity and clears routing cache."
          }
        },
        {
          "name": "Voice Incident (Text-transcribed)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Accident reported on GH Road near Sector 16. Police needed immediately.\",\n  \"channel\": \"radio\"\n}"
            },
            "url": {
              "raw": "http://localhost:8000/incident/voice",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["incident", "voice"]
            },
            "description": "Triggers an incident using parsed text representing transcribed radio/call voice alerts."
          }
        },
        {
          "name": "Voice Incident (Audio File upload)",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": [],
                  "description": "Audio recording of incident report (WAV/MP3/M4A)"
                }
              ]
            },
            "url": {
              "raw": "http://localhost:8000/incident/voice-audio",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8000",
              "path": ["incident", "voice-audio"]
            },
            "description": "Uploads an audio file, transcribes it with Whisper API, parses details using LLM, and triggers the incident."
          }
        }
      ]
    },
